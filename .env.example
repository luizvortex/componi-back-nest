# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─────────────────────────────────────────────
# Database (Supabase Postgres)
# Use the "Connection Pooling" string from Supabase dashboard for serverless,
# or the direct connection string for long-running servers.
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres
DATABASE_SSL=true
DATABASE_LOGGING=false
DATABASE_SYNCHRONIZE=false

# ─────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT validation strategy: "hs256" (shared secret) or "jwks" (RS256 via JWKS endpoint)
SUPABASE_JWT_STRATEGY=hs256
# Required when strategy=hs256. Found in Supabase → Settings → API → JWT Secret.
SUPABASE_JWT_SECRET=your-jwt-secret
# Required when strategy=jwks. Usually ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URI=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=

# ─────────────────────────────────────────────
# Storage (Supabase Storage bucket for thumbnails)
# ─────────────────────────────────────────────
SUPABASE_STORAGE_BUCKET=component-thumbnails

# ─────────────────────────────────────────────
# Redis (rate limit + cache + BullMQ queues)
# Use `redis://default:<password>@host:6379` for managed Redis.
# Local dev: `docker run -p 6379:6379 redis:7-alpine`
# ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_TLS=false
REDIS_KEY_PREFIX=componi:
CACHE_DEFAULT_TTL=60
CACHE_FEED_TTL=30
QUEUE_CONCURRENCY=8
QUEUE_KEEP_COMPLETED=500
QUEUE_KEEP_FAILED=5000

# ─────────────────────────────────────────────
# Rate limiting (keyed by userId when authenticated, IP otherwise)
# Three tiers run together — the strictest trips first.
# ─────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100
THROTTLE_SHORT_LIMIT=20
THROTTLE_LONG_LIMIT=2000
