# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─────────────────────────────────────────────
# Database (Supabase Postgres)
# Use the "Connection Pooling" string from Supabase dashboard for serverless,
# or the direct connection string for long-running servers.
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres
DATABASE_SSL=true
DATABASE_LOGGING=false
DATABASE_SYNCHRONIZE=false

# ─────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT validation strategy: "hs256" (shared secret) or "jwks" (RS256 via JWKS endpoint)
SUPABASE_JWT_STRATEGY=hs256
# Required when strategy=hs256. Found in Supabase → Settings → API → JWT Secret.
SUPABASE_JWT_SECRET=your-jwt-secret
# Required when strategy=jwks. Usually ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URI=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=

# ─────────────────────────────────────────────
# Storage (Supabase Storage bucket for thumbnails)
# ─────────────────────────────────────────────
SUPABASE_STORAGE_BUCKET=component-thumbnails

# ─────────────────────────────────────────────
# Redis (rate limit + cache + BullMQ queues)
# Use `redis://default:<password>@host:6379` for managed Redis.
# Local dev: `docker run -p 6379:6379 redis:7-alpine`
# ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_TLS=false
REDIS_KEY_PREFIX=componi:
CACHE_DEFAULT_TTL=60
CACHE_FEED_TTL=30
QUEUE_CONCURRENCY=8
QUEUE_KEEP_COMPLETED=500
QUEUE_KEEP_FAILED=5000
# When false, workers don't poll Redis — enqueues still write jobs but
# no consumer processes them. Useful on free-tier Redis (Upstash's 10k
# cmd/day cap disappears fast against an idling BullMQ worker). Run a
# separate "worker" process with this flag set to true on demand.
QUEUE_WORKERS_ENABLED=true

# ─────────────────────────────────────────────
# Rate limiting (keyed by userId when authenticated, IP otherwise)
# Three tiers run together — the strictest trips first.
# ─────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100
THROTTLE_SHORT_LIMIT=20
THROTTLE_LONG_LIMIT=2000

# ─────────────────────────────────────────────
# Admin bootstrap
# ─────────────────────────────────────────────
# Required ONLY to run `npm run admin:promote`. Keep this in a secrets
# manager (1Password / AWS Secrets Manager / Vault), NEVER in git. Must
# be ≥ 32 characters. The script also requires --confirm <same-secret>
# to prevent accidental runs in shells where the env is already set.
#
# After bootstrapping the first admin, subsequent promotions happen
# via the admin API (POST /admin/users/:id/role) which audits properly.
ADMIN_BOOTSTRAP_SECRET=

# ─────────────────────────────────────────────
# Compliance (LGPD / GDPR — docs/PRIVACY.md, docs/TERMS.md)
# Bumping either string makes existing consent acceptances stale and
# triggers a re-prompt on next login. Must match the "Version:" header
# in the corresponding markdown file.
# ─────────────────────────────────────────────
PRIVACY_VERSION=2026-04-23
TERMS_VERSION=2026-04-23

# ─────────────────────────────────────────────
# Embeddings (local ONNX via @xenova/transformers)
# Free, runs in-process, ~130MB model + ~150MB RAM.
# Set EMBEDDINGS_ENABLED=false to disable the semantic search pipeline
# (e.g. dev without enough RAM, or initial bootstrap).
# ─────────────────────────────────────────────
EMBEDDINGS_ENABLED=true
EMBEDDINGS_MODEL=Xenova/multilingual-e5-small
EMBEDDINGS_DIMENSIONS=384
EMBEDDINGS_MAX_INPUT_CHARS=1800
EMBEDDINGS_MAX_QUERY_CHARS=200
EMBEDDINGS_SEARCH_CACHE_TTL=300

# ─────────────────────────────────────────────
# Realtime (Socket.IO at /realtime namespace)
# Set REALTIME_ADAPTER=redis when running >1 instance — required so
# events emitted on instance A reach clients connected to instance B.
# ─────────────────────────────────────────────
REALTIME_ENABLED=true
REALTIME_ADAPTER=memory
REALTIME_NAMESPACE=/realtime
REALTIME_MAX_COMPONENT_SUBSCRIPTIONS=20
